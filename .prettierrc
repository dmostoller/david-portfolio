{
  "plugins": ["prettier-plugin-astro"],
  "overrides": [
    {
      "files": "*.astro",
      "options": {
        "parser": "astro",
        "useTabs": true,
        "singleQuote": true,
        "jsxSingleQuote": true,
        "printWidth": 120,
        "experimentalTernaries": true
      }
    }
  ]
}
