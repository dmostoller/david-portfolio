---
// The scrolling traffic chart: attack bursts get scrubbed out of the clean
// signal. scripts/scope/chart.ts flashes the detector as bursts reach it and
// lets visitors click to launch their own.
import { scrubbedTraffic } from '../../lib/scope/traffic';

interface Props {
	/** Height utilities for the plot. */
	class?: string;
}

const { class: className = 'h-40' } = Astro.props;
// One full loop of the chart, in milliseconds.
const period = 28_000;
const traffic = scrubbedTraffic();
const thresholdTop = `${((traffic.thresholdY / traffic.height) * 100).toFixed(2)}%`;
const chart = JSON.stringify({
	period,
	width: traffic.width,
	samples: traffic.samples,
	dx: traffic.dx,
	cleanY: traffic.cleanY,
	unit: traffic.unit,
	detections: traffic.detections,
});
---

<div class='traffic group relative cursor-crosshair select-none' data-traffic={chart} aria-hidden='true'>
	<svg
		viewBox={`0 0 ${traffic.width} ${traffic.height}`}
		preserveAspectRatio='none'
		class:list={['block w-full', className]}
	>
		<defs>
			<pattern id='scrub-hatch' width='5' height='5' patternUnits='userSpaceOnUse' patternTransform='rotate(45)'>
				<line x1='0' y1='0' x2='0' y2='5' stroke='currentColor' stroke-width='1.2'></line>
			</pattern>
		</defs>
		<line
			data-threshold
			x1='0'
			x2={traffic.width}
			y1={traffic.thresholdY}
			y2={traffic.thresholdY}
			stroke='currentColor'
			stroke-dasharray='3 4'
			stroke-width='1'
			vector-effect='non-scaling-stroke'
			class='text-muted-foreground/50'></line>
		<g class='traffic-scroll' data-traffic-scroll style={`--traffic-period: ${period}ms`}>
			<path d={traffic.scrubbed} fill='url(#scrub-hatch)' class='text-muted-foreground/35'></path>
			<path
				d={traffic.ingress}
				fill='none'
				stroke='currentColor'
				stroke-width='1'
				stroke-linejoin='round'
				vector-effect='non-scaling-stroke'
				class='text-muted-foreground/70'></path>
			<path
				d={traffic.clean}
				fill='none'
				stroke='currentColor'
				stroke-width='1.75'
				stroke-linejoin='round'
				vector-effect='non-scaling-stroke'
				class='text-primary'></path>
		</g>
		<!-- Visitor-launched attacks. chart.ts moves them in step with the scroll. -->
		<g data-attacks></g>
	</svg>
	<span
		data-detector
		class='detector absolute right-2 -translate-y-full pb-0.5 text-[10px] text-muted-foreground'
		style={`top: ${thresholdTop}`}
	>
		detect
	</span>
	<span class='absolute left-2 top-1.5 text-[10px] text-muted-foreground'>
		scrubbed <span data-scrubbed class='scrubbed-count inline-block tabular-nums text-foreground'>0</span>
	</span>
	<span
		class='absolute bottom-1.5 left-2 text-[10px] text-muted-foreground opacity-0 transition-opacity group-hover:opacity-100'
	>
		click to attack
	</span>
</div>

<style>
	.traffic-scroll {
		animation: traffic-scroll var(--traffic-period) linear infinite;
	}
	@keyframes traffic-scroll {
		to {
			transform: translateX(-680px);
		}
	}

	/* The detector flashes red when a burst reaches it, then teal once it's scrubbed. */
	.detector {
		transition: color 150ms;
	}
	.detector[data-state='alert'] {
		color: var(--destructive);
		text-shadow: 0 0 8px color-mix(in oklch, var(--destructive) 60%, transparent);
	}
	.detector[data-state='clear'] {
		color: var(--primary);
		text-shadow: 0 0 8px color-mix(in oklch, var(--primary) 50%, transparent);
	}
	.traffic:has(.detector[data-state='alert']) [data-threshold] {
		color: var(--destructive);
	}
	.scrubbed-count[data-bumped] {
		animation: count-bump 400ms var(--ease-out);
	}
	@keyframes count-bump {
		from {
			color: var(--primary);
			translate: 0 -3px;
		}
	}

	/* Visitor-launched attacks rise out of the clean line in red, then get
	   hatched and greyed like the rest once they're scrubbed. */
	.traffic :global(.attack) {
		transform-box: fill-box;
		transform-origin: bottom;
		animation: attack-rise 200ms var(--ease-out);
		transition: opacity 600ms;
	}
	.traffic :global(.attack-ingress) {
		color: var(--destructive);
		transition: color 400ms;
	}
	.traffic :global(.attack-scrubbed) {
		opacity: 0;
		transition: opacity 400ms;
	}
	.traffic :global(.attack[data-scrubbed] .attack-ingress) {
		color: color-mix(in oklch, var(--muted-foreground) 70%, transparent);
	}
	.traffic :global(.attack[data-scrubbed] .attack-scrubbed) {
		opacity: 1;
	}
	.traffic :global(.attack[data-leaving]) {
		opacity: 0;
	}
	@keyframes attack-rise {
		from {
			transform: scaleY(0);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.traffic-scroll,
		.scrubbed-count[data-bumped],
		.traffic :global(.attack) {
			animation: none;
		}
	}
</style>
