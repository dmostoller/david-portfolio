---
const year = new Date().getFullYear();
---

<footer class='w-full max-w-170 mx-auto px-6 py-12 mt-auto'>
	<div
		class='pt-8 border-t border-border flex flex-col sm:flex-row justify-between items-center gap-4 text-sm text-muted-foreground'
	>
		<p>&copy; {year} David Mostoller</p>
		<p class='flex items-center gap-1'>
			Built with
			<a
				href='https://astro.build'
				target='_blank'
				rel='noopener noreferrer'
				class='hover:text-primary transition-colors'
			>
				Astro
			</a>
		</p>
	</div>
</footer>
