---
// The easter egg: an A/B monitor switch. A is Signal, B is Scope. Flipping it
// plays the crossing (src/scripts/crossing.ts) and loads the same page on the other side.
interface Props {
	state: 'a' | 'b';
	href: string;
	label: string;
	class?: string;
}

const { state, href, label, class: className } = Astro.props;
---

<a href={href} rel='nofollow' data-ab-switch data-state={state} aria-label={label} title='A/B' class:list={['ab-switch', className]}>
	<span class='ab-side' data-side='a'>A</span>
	<span class='ab-track' aria-hidden='true'><span class='ab-knob'></span></span>
	<span class='ab-side' data-side='b'>B</span>
</a>

<style>
	.ab-switch {
		display: inline-flex;
		align-items: center;
		gap: 0.375rem;
		padding: 0.25rem 0.125rem;
		font-family: var(--font-mono);
		font-size: 10px;
		line-height: 1;
		color: var(--muted-foreground);
	}
	.ab-track {
		position: relative;
		width: 1.5rem;
		height: 0.75rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		transition: border-color 150ms;
	}
	.ab-knob {
		position: absolute;
		top: 50%;
		left: 2px;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 999px;
		background: currentColor;
		transform: translate(0, -50%);
		transition:
			transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
			background-color 150ms;
	}
	.ab-switch[data-state='b'] .ab-knob {
		transform: translate(0.75rem, -50%);
		background: var(--primary);
	}
	.ab-switch[data-state='a'] [data-side='a'],
	.ab-switch[data-state='b'] [data-side='b'] {
		color: var(--foreground);
	}
	/* A small nudge toward the other side hints that it moves. */
	.ab-switch:hover .ab-track {
		border-color: var(--muted-foreground);
	}
	.ab-switch[data-state='a']:hover .ab-knob {
		transform: translate(0.2rem, -50%);
	}
	.ab-switch[data-state='b']:hover .ab-knob {
		transform: translate(0.55rem, -50%);
	}
	@media (prefers-reduced-motion: reduce) {
		.ab-knob {
			transition: none;
		}
	}
</style>
