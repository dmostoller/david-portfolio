---
interface Props {
  width?: number;
  height?: number;
  direction?: 'left' | 'right';
  class?: string;
}

const {
  width = 20,
  height = 20,
  direction = 'left',
  class: className = ''
} = Astro.props;

const patternId = `stripes-${Math.random().toString(36).slice(2, 9)}`;
---

<div class:list={['fixed inset-0 -z-20 pointer-events-none', className]}>
  <svg
    aria-hidden="true"
    class="absolute inset-0 h-full w-full stroke-[0.5]"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <pattern id={patternId} width={width} height={height} patternUnits="userSpaceOnUse">
        {direction === 'left' ? (
          <>
            <line x1="0" y1={height} x2={width} y2="0" stroke="currentColor" />
            <line x1={-width} y1={height} x2="0" y2="0" stroke="currentColor" />
            <line x1={width} y1={height} x2={width * 2} y2="0" stroke="currentColor" />
          </>
        ) : (
          <>
            <line x1="0" y1="0" x2={width} y2={height} stroke="currentColor" />
            <line x1={-width} y1="0" x2="0" y2={height} stroke="currentColor" />
            <line x1={width} y1="0" x2={width * 2} y2={height} stroke="currentColor" />
          </>
        )}
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill={`url(#${patternId})`} />
  </svg>
</div>

<style>
  div {
    mask-image: radial-gradient(600px circle at center, transparent, white);
  }
</style>
