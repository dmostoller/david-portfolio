---
import { ClientRouter } from 'astro:transitions';
import { Analytics } from '@vercel/analytics/react';
import StripedBackground from '../components/ui/StripedBackground.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
	ogImage?: string;
}

const {
	title,
	description = 'Software engineer building thoughtful digital experiences.',
	ogImage,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL =
	ogImage || new URL(`/api/og.png?title=${encodeURIComponent(title)}`, Astro.site).toString();
---

<!doctype html>
<html lang='en' class='scroll-smooth'>
	<head>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1' />
		<link rel='apple-touch-icon' sizes='180x180' href='/apple-touch-icon.png' />
		<link rel='icon' type='image/png' sizes='32x32' href='/favicon-32x32.png' />
		<link rel='icon' type='image/png' sizes='16x16' href='/favicon-16x16.png' />
		<link rel='manifest' href='/site.webmanifest' />
		<link rel='canonical' href={canonicalURL} />

		<!-- Fonts (async load to prevent render blocking) -->
		<link rel='preconnect' href='https://fonts.googleapis.com' />
		<link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
		<link
			href='https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@400;500;600&family=Playfair+Display:wght@400;500;600&display=swap'
			rel='stylesheet'
			media='print'
			onload="this.media='all'"
		/>
		<noscript>
			<link
				href='https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500&family=Inter:wght@400;500;600&family=Playfair+Display:wght@400;500;600&display=swap'
				rel='stylesheet'
			/>
		</noscript>

		<!-- SEO -->
		<title>{title}</title>
		<meta name='description' content={description} />

		<!-- Open Graph -->
		<meta property='og:title' content={title} />
		<meta property='og:description' content={description} />
		<meta property='og:image' content={ogImageURL} />
		<meta property='og:url' content={canonicalURL} />
		<meta property='og:type' content='website' />

		<!-- Twitter -->
		<meta name='twitter:card' content='summary_large_image' />
		<meta name='twitter:title' content={title} />
		<meta name='twitter:description' content={description} />
		<meta name='twitter:image' content={ogImageURL} />

		<!-- View Transitions -->
		<ClientRouter />

		<script is:inline>
			document.addEventListener('astro:after-swap', () => {
				const main = document.getElementById('main-content');
				if (main) {
					window.scrollTo({ top: 0, left: 0, behavior: 'instant' });
					main.focus({ preventScroll: true });
				}
			});
		</script>

		<!-- Dark mode script (prevent flash + persist across View Transitions) -->
		<script is:inline>
			function applyTheme() {
				const theme =
					localStorage.getItem('theme') ||
					(window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
				document.documentElement.classList.toggle('dark', theme === 'dark');
			}
			// Apply on initial load
			applyTheme();
			// Re-apply after View Transitions page swap
			document.addEventListener('astro:after-swap', applyTheme);
		</script>

		<!-- Button press animation -->
		<script>
			const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			if (!prefersReducedMotion) {
				const ease = 'cubic-bezier(0.22, 1, 0.36, 1)';
				let pressedEl: Element | null = null;

				function handlePress(e: PointerEvent) {
					const el = (e.target as Element)?.closest('a, button, [role="button"]');
					if (!el || el.hasAttribute('disabled')) return;
					pressedEl = el;
					el.animate(
						{ transform: ['scale(1)', 'scale(0.97)'] },
						{ duration: 100, easing: ease, fill: 'forwards' }
					);
				}

				function handleRelease() {
					if (!pressedEl) return;
					pressedEl.animate(
						{ transform: ['scale(0.97)', 'scale(1)'] },
						{ duration: 150, easing: ease, fill: 'forwards' }
					);
					pressedEl = null;
				}

				document.addEventListener('pointerdown', handlePress);
				document.addEventListener('pointerup', handleRelease);
				document.addEventListener('pointercancel', handleRelease);
				document.addEventListener('pointerleave', handleRelease);
			}
		</script>
	</head>
	<body class='min-h-screen flex flex-col bg-background text-foreground'>
		<StripedBackground class='opacity-[0.15] text-foreground' transition:persist />
		<a
			href='#main-content'
			class='sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-6 focus:py-3 focus:bg-primary focus:text-primary-foreground focus:rounded-md focus:font-medium focus:shadow-lg'
		>
			Skip to main content
		</a>
		<Header />
		<main id='main-content' tabindex='-1' class='flex-1 w-full max-w-170 mx-auto px-6 py-12 md:py-20'>
			<slot />
		</main>
		<Footer />
		<Analytics client:load />
	</body>
</html>
