---
import ScopeLayout from '../../layouts/ScopeLayout.astro';
import Pane from '../../components/scope/Pane.astro';
import ScopeTitle from '../../components/scope/ScopeTitle.astro';
import { feedCacheControl, getBooks } from '../../lib/content';
import { formatDate } from '../../lib/format';
import { getSavedArticles } from '../../lib/inoreader';

// Rendered on request and cached at the CDN, like the Signal version.
export const prerender = false;

const articles = await getSavedArticles();
Astro.response.headers.set('Cache-Control', feedCacheControl(articles.length > 0));

// Books as a download queue. There's no real progress data, so "reading" is an
// indeterminate bar rather than a made-up percentage.
const states = { Reading: 'reading', Finished: 'done', 'Up next': 'queued' } as const;
const queue = getBooks().flatMap((group) => group.books.map((book) => ({ ...book, state: states[group.label as keyof typeof states] })));
const reading = queue.filter((b) => b.state === 'reading').length;
---

<ScopeLayout page='reading' status={`${queue.length} books · ${articles.length} saved`}>
	<ScopeTitle
		title='reading'
		description='Current reads and bookmarked articles.'
		meta={`${reading} in progress · ${articles.length} saved`}
	/>

	<div class='grid items-start gap-4 lg:grid-cols-12'>
		<Pane title='queue' aside={`${queue.length} books`} class='lg:col-span-5' bodyClass='p-0'>
			<ol class='divide-y divide-border'>
				{
					queue.map((book) => (
						<li data-row class='space-y-2 px-3 py-3'>
							<div class='flex items-center gap-3 text-[10px] uppercase tracking-wider'>
								<span class:list={['w-14 shrink-0', book.state === 'reading' ? 'text-primary' : 'text-muted-foreground']}>
									{book.state}
								</span>
								<span class='queue-bar flex-1' data-state={book.state} aria-hidden='true' />
							</div>
							<p class='leading-snug text-foreground'>
								{book.title}
								<span class='text-muted-foreground'> — {book.author}</span>
							</p>
						</li>
					))
				}
			</ol>
		</Pane>

		<Pane title='saved' aside='via inoreader' class='lg:col-span-7' bodyClass='p-0'>
			{
				articles.length === 0 ?
					<p class='px-3 py-4 text-muted-foreground'>saved articles couldn't be loaded right now.</p>
				:	<ol class='divide-y divide-border text-[12px]'>
						{articles.map((a) => (
							<li data-row data-href={a.link} class='grid grid-cols-[5.75rem_1fr] gap-x-3 px-3 py-2.5'>
								<time datetime={a.pubDate} class='text-muted-foreground'>
									{formatDate(a.pubDate, 'iso')}
								</time>
								<div class='min-w-0'>
									<a href={a.link} class='text-foreground transition-colors hover:text-primary'>
										{a.title}
									</a>
									<p class='truncate text-[11px] text-muted-foreground'>{a.source}</p>
								</div>
							</li>
						))}
					</ol>
			}
		</Pane>
	</div>
</ScopeLayout>
