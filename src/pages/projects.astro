---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/signal/PageHeader.astro';
import Section from '../components/signal/Section.astro';
import { archivedProjects, projectLink, selectedProjects } from '../lib/content';
import { pageMeta } from '../lib/routes';

export const prerender = true;

const linkClass = 'hover:text-foreground transition-colors';
---

<BaseLayout page='projects'>
	<div class='space-y-14'>
		<PageHeader title='Projects' description={pageMeta('projects').description} />

		<Section label='Selected' divider={false}>
			<ul class='space-y-8'>
				{
					selectedProjects.map((p) => (
						<li>
							<div class='flex items-baseline justify-between gap-4'>
								<h3 class='font-medium text-foreground'>
									<a href={projectLink(p)} class='hover:text-primary transition-colors'>
										{p.title}
									</a>
								</h3>
								<span class='flex shrink-0 gap-3 font-mono text-xs text-muted-foreground'>
									{p.live && (
										<a href={p.live} class={linkClass}>
											Live ↗
										</a>
									)}
									{p.github && (
										<a href={p.github} class={linkClass}>
											Source ↗
										</a>
									)}
								</span>
							</div>
							<p class='mt-1 text-sm text-muted-foreground leading-relaxed'>{p.description}</p>
							<p class='mt-2 font-mono text-[11px] text-muted-foreground'>{p.tech.join(' · ')}</p>
						</li>
					))
				}
			</ul>
		</Section>

		<Section label='Archive' aside={`${archivedProjects.length} older projects`}>
			<ul class='divide-y divide-border border-y border-border'>
				{
					archivedProjects.map((p) => (
						<li class='flex items-baseline justify-between gap-4 py-2.5 text-sm'>
							<a href={projectLink(p)} class='min-w-0 truncate text-foreground hover:text-primary transition-colors'>
								{p.title}
							</a>
							<span class='hidden sm:block shrink-0 font-mono text-[11px] text-muted-foreground'>
								{p.tech.slice(0, 3).join(' · ')}
							</span>
						</li>
					))
				}
			</ul>
		</Section>
	</div>
</BaseLayout>
