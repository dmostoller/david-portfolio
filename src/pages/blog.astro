---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPostPreview from '../components/sections/BlogPostPreview';
import PressArticlePreview from '../components/sections/PressArticlePreview';
import { getMediumPosts } from '../lib/medium';
import press from '../content/press.json';

export const prerender = true;

const posts = await getMediumPosts('dmostoller');
---

<BaseLayout
	title='Writing — David Mostoller'
	description='Published work and thoughts on software, design, and building things.'
>
	<section class='space-y-12'>
		<header class='space-y-2'>
			<h1 class='text-2xl sm:text-3xl font-semibold text-foreground tracking-tight'>Writing</h1>
			<p class='text-muted-foreground'>
				Published work and thoughts on software, design, and building things.
			</p>
		</header>

		<div class='space-y-4'>
			<h2 class='text-sm font-medium text-muted-foreground uppercase tracking-wider'>Published</h2>
			<div class='space-y-1'>
				{
					press.map((article, index) => (
						<PressArticlePreview
							client:visible
							title={article.title}
							publication={article.publication}
							url={article.url}
							date={article.date}
							description={article.description}
							index={index}
						/>
					))
				}
			</div>
		</div>

		<div class='space-y-4'>
			<h2 class='text-sm font-medium text-muted-foreground uppercase tracking-wider'>Blog</h2>
			<div class='space-y-1'>
				{
					posts.length > 0 ?
						posts.map((post, index) => (
							<BlogPostPreview
								client:visible
								title={post.title}
								href={post.link}
								date={post.pubDate}
								description={post.description ?? ''}
								index={index}
							/>
						))
					:	<p class='text-muted-foreground py-8'>No posts yet. Check back soon!</p>
				}
			</div>

			<a
				href='https://medium.com/@dmostoller'
				target='_blank'
				rel='noopener noreferrer'
				class='inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-primary transition-colors'
			>
				View all posts on Medium
				<span>&rarr;</span>
			</a>
		</div>
	</section>
</BaseLayout>
