---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogPostPreview from '../components/sections/BlogPostPreview';
import { getMediumPosts } from '../lib/medium';

export const prerender = true;

const posts = await getMediumPosts('dmostoller');
---

<BaseLayout title='Blog — David Mostoller' description='Thoughts on software, design, and building things.'>
	<section class='space-y-8'>
		<header class='space-y-2'>
			<h1 class='text-2xl sm:text-3xl font-semibold text-foreground tracking-tight'>Writing</h1>
			<p class='text-muted-foreground'>Thoughts on software, design, and building things.</p>
		</header>

		<div class='space-y-1'>
			{
				posts.length > 0 ?
					posts.map((post, index) => (
						<BlogPostPreview
							client:visible
							title={post.title}
							href={post.link}
							date={post.pubDate}
							description={post.description}
							index={index}
						/>
					))
				:	<p class='text-muted-foreground py-8'>No posts yet. Check back soon!</p>
			}
		</div>

		<a
			href='https://medium.com/@dmostoller'
			target='_blank'
			rel='noopener noreferrer'
			class='inline-flex items-center gap-2 text-sm text-muted-foreground hover:text-primary transition-colors'
		>
			View all posts on Medium
			<span>&rarr;</span>
		</a>
	</section>
</BaseLayout>
