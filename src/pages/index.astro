---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/sections/SocialLinks';
import headshot from '../assets/headshot.jpg';

export const prerender = true;
---

<BaseLayout title='David Mostoller — Software Engineer'>
	<article class='space-y-12'>
		<!-- Hero Section -->
		<header class='flex flex-col sm:flex-row sm:items-center gap-6' transition:animate='slide'>
			<Image
				src={headshot}
				alt='David Mostoller'
				width={224}
				height={224}
				densities={[1, 2]}
				format='webp'
				class='w-24 h-24 sm:w-28 sm:h-28 rounded-full object-cover ring-2 ring-border shadow-lg'
			/>
			<div class='space-y-2'>
				<h1 class='text-2xl sm:text-3xl font-semibold text-foreground tracking-tight'>David Mostoller</h1>
				<p class='text-muted-foreground text-lg'>Software Engineer · Builder</p>
			</div>
		</header>

		<!-- Bio -->
		<section class='prose-minimal space-y-4' transition:animate='fade'>
			<p>
				I'm a full-stack software engineer who believes that the design of impactful web technologies emerges
				from iterative, team collaborations. I'm currently building with TypeScript, React, Tanstack, and
				Python.
			</p>
			<p>
				I have a background in audio engineering and music technology, and perform under the name <span
					class='font-medium'>Kabayun</span
				> in my free time.
			</p>
			<p>When at home in Philly, I am often on my bicycle or reading a sci-fi novel.</p>
		</section>

		<!-- Skills -->
		<section class='pt-8 border-t border-border' transition:animate='fade'>
			<h2 class='text-sm font-medium text-muted-foreground uppercase tracking-wider mb-4'>Skills</h2>
			<div class='flex flex-wrap gap-2'>
				{
					[
						'TypeScript',
						'JavaScript',
						'Python',
						'React',
						'Tanstack',
						'Next.js',
						'Astro',
						'Tailwind CSS',
						'Shadcn/ui',
						'GraphQL',
						'PostgreSQL',
						'SQLite',
						'AWS',
						'Django',
						'Flask',
						'Node.js',
						'Prisma',
						'REST APIs',
						'Git',
						'CI/CD',
						'Docker',
					].map((skill) => (
						<span class='text-sm px-3 py-1 bg-muted text-muted-foreground rounded-md'>{skill}</span>
					))
				}
			</div>
		</section>

		<!-- Current Role -->
		<section class='pt-8 border-t border-border' transition:animate='fade'>
			<h2 class='text-sm font-medium text-muted-foreground uppercase tracking-wider mb-4'>Current Role</h2>
			<div class='border-l-2 border-primary pl-4'>
				<h3 class='font-medium text-foreground'>Software Engineer</h3>
				<p class='text-sm text-muted-foreground'>Comcast · 2025 - Present</p>
				<p class='text-sm text-muted-foreground mt-2'>
					Developing full-stack cybersecurity applications that support enterprise-scale network protection.
				</p>
			</div>
		</section>

		<!-- Education -->
		<section class='pt-8 border-t border-border' transition:animate='fade'>
			<h2 class='text-sm font-medium text-muted-foreground uppercase tracking-wider mb-4'>Education</h2>
			<div class='space-y-4'>
				<div class='border-l-2 border-primary pl-4'>
					<h3 class='font-medium text-foreground'>Wesleyan University</h3>
					<p class='text-sm text-muted-foreground'>B.A. Government</p>
				</div>
				<div class='border-l-2 border-primary pl-4'>
					<h3 class='font-medium text-foreground'>Flatiron School</h3>
					<p class='text-sm text-muted-foreground'>Software Engineering</p>
				</div>
			</div>
		</section>

		<!-- Social Links -->
		<SocialLinks client:visible />
	</article>
</BaseLayout>
