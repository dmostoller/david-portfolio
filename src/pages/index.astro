---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/sections/SocialLinks';
import headshot from '../assets/headshot.jpg';

export const prerender = true;
---

<BaseLayout
	title='David Mostoller — Senior Software Engineer'
	description='Senior software engineer building security tools, threat intelligence platforms, and automated defenses for network security at Comcast.'
>
	<article class='space-y-12'>
		<!-- Hero Section -->
		<header class='flex flex-col sm:flex-row sm:items-center gap-6' transition:animate='slide'>
			<Image
				src={headshot}
				alt='David Mostoller'
				width={224}
				height={224}
				densities={[1, 2]}
				format='webp'
				class='w-24 h-24 sm:w-28 sm:h-28 rounded-full object-cover ring-2 ring-border shadow-lg'
			/>
			<div class='space-y-2'>
				<h1 class='text-2xl sm:text-3xl font-semibold text-foreground tracking-tight'>David Mostoller</h1>
				<p class='text-muted-foreground text-lg'>Senior Software Engineer · Cybersecurity · Musician</p>
			</div>
		</header>

		<!-- Bio -->
		<section class='prose-minimal space-y-4' transition:animate='fade'>
			<p>
				I'm a senior software engineer on Comcast's DDoS Mitigation Services team, building the internal tools,
				intelligence platforms, and automation that security engineers use to protect one of the largest
				networks in the U.S.
			</p>
			<p>
				Outside of software, I produce electronic music as <a
					href='https://kabayun.com'
					target='_blank'
					rel='noopener noreferrer'>Kabayun</a
				> and <a href='https://superluminalpsy.com' target='_blank' rel='noopener noreferrer'>Superluminal</a
				>, drawing on a background in audio engineering and music technology.
			</p>
			<p>
				When I'm not coding or making music, you'll often find me on my bicycle or lost in a sci-fi novel.
			</p>
		</section>

		<!-- Skills -->
		<section class='pt-8 border-t border-border' transition:animate='fade'>
			<h2 class='text-sm font-medium text-muted-foreground uppercase tracking-wider mb-4'>Skills</h2>
			<div class='space-y-3'>
				<div class='flex flex-wrap gap-2'>
					{
						[
							'Python',
							'TypeScript',
							'JavaScript',
							'React',
							'Tanstack',
							'Next.js',
							'Astro',
							'Tailwind CSS',
							'Shadcn/ui',
							'GraphQL',
							'PostgreSQL',
							'SQLite',
							'AWS',
							'Django',
							'Flask',
							'Node.js',
							'Prisma',
							'REST APIs',
							'Git',
							'CI/CD',
							'Docker',
						].map((skill) => (
							<span class='text-sm px-3 py-1 bg-muted text-muted-foreground rounded-md'>{skill}</span>
						))
					}
				</div>
				<div class='flex flex-wrap gap-2'>
					{
						[
							'DDoS Mitigation',
							'Threat Intelligence',
							'Network Traffic Analysis',
							'Security Automation',
							'LLM Agents',
						].map((skill) => (
							<span class='text-sm px-3 py-1 bg-muted text-muted-foreground rounded-md'>{skill}</span>
						))
					}
				</div>
			</div>
		</section>

		<!-- Current Role -->
		<section class='pt-8 border-t border-border' transition:animate='fade'>
			<h2 class='text-sm font-medium text-muted-foreground uppercase tracking-wider mb-4'>Current Role</h2>
			<div class='border-l-2 border-primary pl-4'>
				<h3 class='font-medium text-foreground'>Senior Software Engineer, Network Security</h3>
				<p class='text-sm text-muted-foreground'>Comcast · 2025 - Present</p>
				<ul class='text-sm text-muted-foreground mt-2 space-y-1.5 list-disc pl-4'>
					<li>
						Build internal tools and platforms that help network and security engineers find, understand, and
						stop threats at enterprise scale.
					</li>
					<li>
						Develop threat intelligence and automation systems, including AI-assisted analysis, that turn raw
						network data into clear, actionable insight.
					</li>
					<li>
						Work closely with security engineers to turn their operational needs into reliable, maintainable
						software.
					</li>
				</ul>
			</div>
		</section>

		<!-- Education -->
		<section class='pt-8 border-t border-border' transition:animate='fade'>
			<h2 class='text-sm font-medium text-muted-foreground uppercase tracking-wider mb-4'>Education</h2>
			<div class='space-y-4'>
				<div class='border-l-2 border-primary pl-4'>
					<h3 class='font-medium text-foreground'>Wesleyan University</h3>
					<p class='text-sm text-muted-foreground'>B.A. Government</p>
				</div>
				<div class='border-l-2 border-primary pl-4'>
					<h3 class='font-medium text-foreground'>Flatiron School</h3>
					<p class='text-sm text-muted-foreground'>Software Engineering</p>
				</div>
			</div>
		</section>

		<!-- Social Links -->
		<SocialLinks client:visible />
	</article>
</BaseLayout>
