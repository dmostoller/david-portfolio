---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/signal/PageHeader.astro';
import Section from '../components/signal/Section.astro';
import { feedCacheControl, getBooks } from '../lib/content';
import { formatDate } from '../lib/format';
import { getSavedArticles } from '../lib/inoreader';
import { pageMeta } from '../lib/routes';

// Rendered on request and cached at the CDN, so saved articles stay fresh
// without a client-side fetch or a loading skeleton.
export const prerender = false;

const bookGroups = getBooks();
const articles = await getSavedArticles();
Astro.response.headers.set('Cache-Control', feedCacheControl(articles.length > 0));
---

<BaseLayout page='reading'>
	<div class='space-y-14'>
		<PageHeader title='Reading' description={pageMeta('reading').description} />

		<Section label='Books' divider={false}>
			<dl class='space-y-5'>
				{
					bookGroups.map((group) => (
						<div class='grid sm:grid-cols-[6.5rem_1fr] gap-1 sm:gap-4'>
							<dt class='flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-muted-foreground h-5'>
								{group.label === 'Reading' && <span class='w-1.5 h-1.5 rounded-full bg-primary' />}
								{group.label}
							</dt>
							<dd>
								<ul class='space-y-2'>
									{group.books.map((b) => (
										<li class='text-sm'>
											<span class='text-foreground'>{b.title}</span>
											<span class='text-muted-foreground'> — {b.author}</span>
										</li>
									))}
								</ul>
							</dd>
						</div>
					))
				}
			</dl>
		</Section>

		<Section label='Saved articles' aside='via Inoreader'>
			{
				articles.length === 0 ?
					<p class='py-4 text-sm text-muted-foreground'>Saved articles couldn't be loaded right now.</p>
				:	<ul class='space-y-5'>
						{articles.map((a) => (
							<li>
								<a href={a.link} class='group block'>
									<h3 class='text-sm font-medium text-foreground group-hover:text-primary transition-colors'>{a.title}</h3>
									<p class='mt-0.5 font-mono text-xs text-muted-foreground'>
										{a.source} · {formatDate(a.pubDate)}
									</p>
								</a>
							</li>
						))}
					</ul>
			}
		</Section>
	</div>
</BaseLayout>
